  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared light appearance; loading/disabled native behavior is documented in DESIGN.md.",
      "html": "<button class=\"ds-button\">Continue</button>",
      "css": ".ds-button{border:0;border-radius:12px;min-height:50px;padding:8px 16px;font:600 15px/21px system-ui,sans-serif;cursor:pointer}.ds-button:hover{opacity:.9}.ds-button:focus-visible{outline:2px solid currentColor;outline-offset:3px}.ds-button:active{opacity:.78;transform:scale(.985)}.ds-button:disabled{opacity:.55;cursor:default}.ds-button:disabled:active{transform:none}@media(prefers-reduced-motion:reduce){.ds-button:active{transform:none}}.ds-button{background:#465CF4;color:#FFFFFF}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared light appearance; loading/disabled native behavior is documented in DESIGN.md.",
      "html": "<button class=\"ds-button\">Continue</button>",
      "css": ".ds-button{border:0;border-radius:12px;min-height:50px;padding:8px 16px;font:600 15px/21px system-ui,sans-serif;cursor:pointer}.ds-button:hover{opacity:.9}.ds-button:focus-visible{outline:2px solid currentColor;outline-offset:3px}.ds-button:active{opacity:.78;transform:scale(.985)}.ds-button:disabled{opacity:.55;cursor:default}.ds-button:disabled:active{transform:none}@media(prefers-reduced-motion:reduce){.ds-button:active{transform:none}}.ds-button{background:#E9ECFF;color:#465CF4}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared light appearance; loading/disabled native behavior is documented in DESIGN.md.",
      "html": "<button class=\"ds-button\">Continue</button>",
      "css": ".ds-button{border:0;border-radius:12px;min-height:50px;padding:8px 16px;font:600 15px/21px system-ui,sans-serif;cursor:pointer}.ds-button:hover{opacity:.9}.ds-button:focus-visible{outline:2px solid currentColor;outline-offset:3px}.ds-button:active{opacity:.78;transform:scale(.985)}.ds-button:disabled{opacity:.55;cursor:default}.ds-button:disabled:active{transform:none}@media(prefers-reduced-motion:reduce){.ds-button:active{transform:none}}.ds-button{background:transparent;color:#636675}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Labelled field with real helper text; browser focus is retained.",
      "html": "<label class=\"ds-field\">Description<input class=\"ds-input\" placeholder=\"Description\"><span class=\"ds-hint\">Add a short description.</span></label>",
      "css": ".ds-field{display:grid;gap:4px;font:600 14px/21px system-ui,sans-serif;color:#191B24}.ds-input{min-height:50px;padding:12px 16px;border:1px solid #DCE0EA;border-radius:10px;background:#FFFFFF;color:#191B24;font:400 16px system-ui,sans-serif}.ds-input::placeholder{color:#636675}.ds-input:hover{border-color:#636675}.ds-input:focus-visible{outline:2px solid #465CF4;outline-offset:2px}.ds-hint{font-weight:400;color:#636675}"
    },
    {
      "name": "Selected Choice",
      "kind": "chip",
      "refersTo": "choice-selected",
      "description": "A selected radio choice within the wrapping Choices group.",
      "html": "<div class=\"ds-choices\" role=\"radiogroup\" aria-label=\"Space\"><button class=\"ds-choice\" role=\"radio\" aria-checked=\"true\">Shared</button><button class=\"ds-choice ds-choice-idle\" role=\"radio\" aria-checked=\"false\">Private</button></div>",
      "css": ".ds-choices{display:flex;flex-wrap:wrap;gap:4px;padding:4px;border-radius:12px;background:#EBEDF5}.ds-choice{flex:1;min-height:48px;padding:8px 16px;border:1px solid #DCE0EA;border-radius:10px;background:#FFFFFF;color:#465CF4;font:600 14px/21px system-ui,sans-serif}.ds-choice-idle{background:transparent;color:#636675;border-color:transparent}.ds-choice:hover{opacity:.9}.ds-choice:focus-visible{outline:2px solid #465CF4;outline-offset:2px}.ds-choice:active{opacity:.72}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat related-content surface without an automatic shadow.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Categories</h2><p class=\"ds-card-copy\">Your shared monthly plan.</p></section>",
      "css": ".ds-card{display:grid;gap:8px;border-radius:16px;background:#FFFFFF;padding:16px;color:#191B24}.ds-card-title{margin:0;font:600 18px/26px system-ui,sans-serif;letter-spacing:-.3px}.ds-card-copy{margin:0;color:#636675;font:400 16px/24px system-ui,sans-serif}"
    },
    {
      "name": "Web Tab Navigation",
      "kind": "nav",
      "refersTo": "web-tabs",
      "description": "Shared light navigation: desktop top bar at effective width 900; narrower web retains bottom tabs. The CSS preview media query assumes font scale 1; native tabs remain platform-rendered.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><button class=\"ds-tab ds-tab-active\" aria-current=\"page\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7m-16-1v12h5v-7h4v7h5V9\"/></svg>Home</button><button class=\"ds-tab\">Shared Budget</button><button class=\"ds-tab\">Private Space</button><button class=\"ds-tab\">Settings</button></nav>",
      "css": ".ds-nav{display:flex;gap:4px;max-width:760px;padding:4px 8px;border-radius:12px;background:#FFFFFF}.ds-tab{display:flex;flex:1;min-width:0;min-height:56px;align-items:center;justify-content:center;flex-direction:column;gap:4px;padding:4px 8px;border:0;border-radius:16px;background:#FFFFFF;color:#636675;font:600 12px/21px system-ui,sans-serif}.ds-tab-active{background:#EBEDF5;color:#465CF4}.ds-tab:hover{opacity:.9}.ds-tab:focus-visible{outline:2px solid #465CF4;outline-offset:2px}.ds-tab:active{opacity:.7}@media(min-width:900px){.ds-nav{max-width:none;padding:4px 24px;gap:16px;border-radius:0}}"
    },
    {
      "name": "Financial Summary",
      "kind": "custom",
      "refersTo": "hero-card",
      "description": "Shared light appearance uses a white surface and normal ink; the summary follows dark appearance when resolved there. Unavailable preview values are not a household balance.",
      "html": "<section class=\"ds-hero\"><h2 class=\"ds-hero-label\">Monthly spending</h2><p class=\"ds-hero-amount\">\u2014</p><p class=\"ds-hero-copy\">Spent</p><div class=\"ds-hero-row\"><span>Planned</span><strong>\u2014</strong></div></section>",
      "css": ".ds-hero{display:grid;gap:8px;padding:16px;border-radius:16px;background:#FFFFFF;color:#191B24}.ds-hero-label{margin:0;font:600 14px/21px system-ui,sans-serif}.ds-hero-amount{margin:0;font:700 34px/42px Manrope,system-ui,sans-serif;letter-spacing:-1px;font-variant-numeric:tabular-nums}.ds-hero-copy{margin:0;color:#636675;font:400 14px/21px system-ui,sans-serif}.ds-hero-row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;color:#636675;font:400 14px/21px system-ui,sans-serif}.ds-hero-row strong{color:#191B24;font-weight:600}"
    },
    {
      "name": "Category Row",
      "kind": "custom",
      "refersTo": "category-tile-orange",
      "description": "Decorative stable-hue tile with wrapping label and signed amount slot.",
      "html": "<div class=\"ds-category\"><span class=\"ds-category-tile\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3v9h9M9 4a9 9 0 1 0 11 11M15 3a9 9 0 0 1 6 6h-6V3Z\"/></svg></span><span class=\"ds-category-name\">Category</span><strong class=\"ds-category-amount\">\u2014</strong></div>",
      "css": ".ds-category{display:flex;flex-wrap:wrap;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid #DCE0EA;color:#191B24;font:600 14px/21px system-ui,sans-serif}.ds-category-tile{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:#FFF0DC;color:#C47A24}.ds-category-name{flex:1 1 100px}.ds-category-amount{font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Progressive Detail",
      "kind": "custom",
      "description": "An in-flow detail group; browser details preserves descendant input state when collapsed, corresponding to mounted Disclosure children.",
      "html": "<details class=\"ds-details\"><summary class=\"ds-disclosure\">More details</summary><div class=\"ds-detail-content\"><label>Note<input class=\"ds-note\" placeholder=\"Optional note\"></label></div></details>",
      "css": ".ds-details{color:#191B24;font:400 14px/21px system-ui,sans-serif}.ds-disclosure{min-height:48px;display:flex;align-items:center;padding:8px 0;border-top:1px solid #DCE0EA;color:#465CF4;font-weight:600;cursor:pointer}.ds-disclosure:hover{opacity:.9}.ds-disclosure:active{opacity:.7}.ds-disclosure:focus-visible,.ds-note:focus-visible{outline:2px solid #465CF4;outline-offset:2px}.ds-detail-content{display:grid;gap:16px;padding-top:8px}.ds-note{display:block;min-height:50px;padding:12px 16px;border:1px solid #DCE0EA;border-radius:10px;color:#191B24;background:#FFFFFF;font:400 16px system-ui,sans-serif}"
